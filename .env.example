# Copia este archivo como .env y ajusta los valores. El archivo .env nunca se sube al repositorio.
# En Render, estas variables se definen en Environment del servicio, no con un archivo.

# Ambiente: test | local | production. Si falta, se asume production (el más estricto),
# que exige DATABASE_URL, SECRET_KEY y GEMINI_API_KEY. Este ejemplo es para desarrollo local.
ENVIRONMENT=local

# Nivel de log: DEBUG | INFO | WARNING | ERROR.
# Por defecto: DEBUG en local, INFO en test y production.
# LOG_LEVEL=DEBUG

# Base de datos. Fuera de producción, por defecto: SQLite en ./pedidofacil.db (local)
# o en memoria (test). En production es obligatoria y debe ser PostgreSQL (Neon), por ejemplo:
#   postgresql://usuario:clave@host/base?sslmode=require
# DATABASE_URL=

# Clave para firmar la sesión del dueño. En production es obligatoria (mínimo 32 caracteres).
# Fuera de producción, si falta, se genera una al azar en cada arranque. Para generarla:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=

# Proveedor de IA: fake | gemini. Por defecto: fake en local y test, gemini en production.
# fake en production se permite, pero deja un aviso WARNING al arrancar.
# AI_PROVIDER=fake

# Clave de la API de Gemini. Obligatoria en production cuando AI_PROVIDER=gemini.
# GEMINI_API_KEY=

# Login del dueño (llega con su historia).
# ADMIN_PASSWORD_HASH=

# Telegram (HU-19 y HU-20)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# OWNER_TELEGRAM_CHAT_ID=
