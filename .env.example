# Copia este archivo como .env y ajusta los valores. El archivo .env nunca se sube al repositorio.
# En Render, estas variables se definen en Environment del servicio, no con un archivo.

# Ambiente: test | local | production. Si falta, se asume production (el más estricto),
# que exige DATABASE_URL, SECRET_KEY, GEMINI_API_KEY y las variables del login con Google.
# Este ejemplo es para desarrollo local.
ENVIRONMENT=local

# Nivel de log: DEBUG | INFO | WARNING | ERROR.
# Por defecto: DEBUG en local, INFO en test y production.
# LOG_LEVEL=DEBUG

# Base de datos. Fuera de producción, por defecto: SQLite en ./pedidofacil.db (local)
# o en memoria (test). En production es obligatoria y debe ser PostgreSQL (Neon), por ejemplo:
#   postgresql://usuario:clave@host/base?sslmode=require
# DATABASE_URL=

# Clave para firmar la sesión del dueño. En production es obligatoria (mínimo 32 caracteres).
# Fuera de producción, si falta, se genera una al azar en cada arranque. Para generarla:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=

# Proveedor de IA: fake | gemini. Por defecto: fake en local y test, gemini en production.
# fake en production se permite, pero deja un aviso WARNING al arrancar.
# AI_PROVIDER=fake

# Clave de la API de Gemini. Obligatoria en production cuando AI_PROVIDER=gemini.
# GEMINI_API_KEY=

# Modelos de Gemini para cotizar. Se cambian según la medición de
# specs/004-cotizacion-con-ia/research.md (R2), sin tocar código. El respaldo solo se usa ante
# un error rápido del principal (503 o 429). Por defecto no hay respaldo: hoy no existe un
# segundo modelo utilizable en la capa gratuita (gemini-3.8-flash quedó descartado por cuota y
# gemini-3.5-flash tarda más que el tiempo de espera). Para activarlo, poner su nombre;
# GEMINI_FALLBACK_MODEL=ninguno lo deja desactivado de forma explícita.
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODEL=

# Segundos máximos de espera a la IA antes del camino manual. Mayor que 0 y como máximo 15
# (principio V de la constitución): con otro valor la app no arranca.
# AI_TIMEOUT_SECONDS=10

# Login del dueño con Google (OAuth 2.0 / OpenID Connect, ADR 0003). La app no guarda contraseñas.
# ID y secreto del cliente OAuth (Google Cloud → Credenciales → ID de cliente de tipo web).
# Obligatorios en production. En local, solo si quieres probar el login real: las pruebas no
# los usan y sin ellos /login/google muestra un aviso de error.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Correos autorizados a entrar, separados por comas (sin distinguir mayúsculas).
# Autenticarse con Google no basta: el correo tiene que estar aquí. Obligatoria en production.
# OWNER_EMAILS=dueno@gmail.com

# URL pública de la app. La URI de vuelta de Google es PUBLIC_BASE_URL/auth/google/callback
# y debe estar registrada en Google Cloud. Por defecto en local: http://127.0.0.1:8000 (abre la
# app en ese mismo host). En production: https://pedidofacil-6nky.onrender.com; si falta, se
# usa RENDER_EXTERNAL_URL, que define Render.
# PUBLIC_BASE_URL=http://127.0.0.1:8000

# Bot de Telegram (HU-20). Opcionales: sin el token y el secreto, el bot queda apagado y su
# webhook responde 404. El secreto se registra en Telegram con setWebhook (secret_token).
# OWNER_TELEGRAM_CHAT_ID es el chat numérico del dueño, que recibe los avisos.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# OWNER_TELEGRAM_CHAT_ID=

# Catálogo de demostración (PED-102): true | false. Por defecto false (si falta, no se siembra).
# Activa, al arrancar crea los productos y variantes de demostración que falten, por nombre;
# nunca modifica ni desactiva lo que ya esté cargado. Sirve para sembrar producción sin consola:
# activarla, desplegar, comprobar el resumen en el log y volver a apagarla.
# SEED_DEMO_CATALOG=false
